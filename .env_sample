
# Google OAuth Credentials
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="my_client_id"
GOOGLE_CLIENT_SECRET="my_secret"

# The ID of the Google Sheet to sync data to
SPREADSHEET_ID="my_shit_id"

GMAIL_USER="email"
APP_PASS="pass"

# Service account credentials file name
CRED_FILE="the_file.json"

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN="your_bot_token_here"
# Comma-separated Telegram user IDs allowed to interact with the bot (leave empty to allow anyone)
ALLOWED_TELEGRAM_USER_IDS="12345678,98765432"
# Default currency for manual expenses entered via Telegram
DEFAULT_CURRENCY="BYN"